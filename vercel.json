{
  "redirects": [
    {
      "source": "/",
      "destination": "/dental/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dental/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}